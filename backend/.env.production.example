PORT=8787
HOST=127.0.0.1
APP_ORIGIN=https://yourdomain.com
JWT_SECRET=replace-with-a-long-random-string

# Aliyun RDS MySQL
DB_HOST=rm-xxxx.mysql.rds.aliyuncs.com
DB_PORT=3306
DB_NAME=report_platform
DB_USER=report_app
DB_PASSWORD=replace-with-rds-password

# Aliyun Bailian / DashScope compatible mode
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=replace-with-your-dashscope-api-key
LLM_MODEL=qwen-plus
MODEL_TIMEOUT_MS=90000

# SMS verification. Use mock until a real provider is configured.
SMS_PROVIDER=mock
SMS_ACCESS_KEY=
SMS_ACCESS_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=

# External channel security
LIZHIHUI_SIGNING_SECRET=replace-with-shared-hmac-secret

# Operations-only API for generating redemption codes.
ADMIN_API_KEY=replace-with-admin-api-key
